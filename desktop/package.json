{
  "name": "esp-zero-ad",
  "version": "1.0.0",
  "description": "ESP32-S3 DNS sinkhole \u2014 desktop setup wizard & dashboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:all": "electron-builder --win --linux --mac"
  },
  "build": {
    "appId": "com.espxero.ad",
    "productName": "ESP-Zero-Ad",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "wizard.html",
      "icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "OnyxNeol",
      "repo": "ESP-Zero-Ad"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OnyxNeol/ESP-Zero-Ad.git"
  }
}